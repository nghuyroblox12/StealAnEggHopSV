local Dragging = false
local DragStart
local StartPosition

TopBar.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position

    end

end)

TopBar.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end

end)

UserInputService.InputChanged:Connect(function(Input)

    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then

        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )

    end

end)

--=========================================================
-- UPDATE CURRENT SERVER
--=========================================================

local function UpdateCurrentServer()

    local CurrentPlayers = #Players:GetPlayers()

    -- Roblox max player count
    local MaxPlayers = Players.MaxPlayers

    if not MaxPlayers or MaxPlayers <= 0 then
        MaxPlayers = 7
    end

    ServerText.Text =
        "NGƯỜI CHƠI TRONG SERVER : [ "
        .. CurrentPlayers
        .. " / "
        .. MaxPlayers
        .. " ]"

    -- CHỈ FULL KHI SERVER THẬT SỰ ĐẦY
    if CurrentPlayers >= MaxPlayers then

        Status.Text = "● ĐẦY"
        Status.TextColor3 = Color3.fromRGB(255, 70, 85)

    elseif CurrentPlayers <= 1 then

        Status.Text = "● ÍT NGƯỜI CHƠI"
        Status.TextColor3 = Color3.fromRGB(0, 255, 170)

    elseif CurrentPlayers <= math.floor(MaxPlayers / 2) then

        Status.Text = "● SẴN SÀNG"
        Status.TextColor3 = Color3.fromRGB(0, 255, 170)

    else

        Status.Text = "● HOẠT ĐỘNG"
        Status.TextColor3 = Color3.fromRGB(255, 200, 70)

    end

end

Players.PlayerAdded:Connect(UpdateCurrentServer)
Players.PlayerRemoving:Connect(UpdateCurrentServer)

UpdateCurrentServer()

--=========================================================
-- SERVER SCANNER
--=========================================================

local function GetLowPlayerServers()

    local FoundServers = {}
    local Cursor = ""

    for Page = 1, MAX_PAGES do

        local URL =
            "https://games.roblox.com/v1/games/"
            .. tostring(PLACE_ID)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if Cursor ~= "" then
            URL = URL .. "&cursor=" .. HttpService:UrlEncode(Cursor)
        end

        local Success, Result = pcall(function()
            return game:HttpGet(URL)
        end)

        if not Success then
            break
        end

        local DecodeSuccess, Data = pcall(function()
            return HttpService:JSONDecode(Result)
        end)

        if not DecodeSuccess or not Data then
            break
        end

        for _, Server in ipairs(Data.data or {}) do

            if Server.id
                and Server.playing ~= nil
                and Server.maxPlayers ~= nil then

                -- Không lấy server hiện tại
                if Server.id ~= game.JobId then

                    -- Chỉ lấy server 0 hoặc 1 người
                    if Server.playing <= TARGET_PLAYERS
                        and Server.playing < Server.maxPlayers then

                        table.insert(FoundServers, Server)

                    end

                end

            end

        end

        Cursor = Data.nextPageCursor or ""

        if Cursor == "" then
            break
        end

        task.wait(0.15)

    end

    return FoundServers

end

--=========================================================
-- HOP
--=========================================================

local Hopping = false

local function ServerHop()

    if Hopping then
        return
    end

    Hopping = true

    -- Scanning
    Status.Text = "● ĐANG TÌM"
    Status.TextColor3 = Color3.fromRGB(255, 205, 70)

    HopButton.Text = "🔎  ĐANG TÌM SERVERS..."
    HopButton.BackgroundColor3 = Color3.fromRGB(35, 45, 55)

    local Servers = GetLowPlayerServers()

    -- Không tìm thấy
    if #Servers == 0 then

        Status.Text = "● KHÔNG TÌM THẤY"
        Status.TextColor3 = Color3.fromRGB(255, 80, 90)

        HopButton.Text = "⚠  KHÔNG TÌM THẤY SEVER"
        HopButton.BackgroundColor3 = Color3.fromRGB(145, 60, 70)

        task.wait(1.2)

        HopButton.Text = "⚡  TÌM SERVER 1 NGƯỜI"
        HopButton.BackgroundColor3 = Color3.fromRGB(0, 175, 120)

        Hopping = false

        return
    end

    -- Chọn server ngẫu nhiên
    local SelectedServer =
        Servers[math.random(1, #Servers)]

    -- Found
    Status.Text = "● ĐÃ TÌM THẤY"
    Status.TextColor3 = Color3.fromRGB(0, 255, 170)

    HopButton.Text =
        "✓  ĐÃ TÌM THẤY "
        .. tostring(SelectedServer.playing)
        .. " PLAYER SERVER"

    HopButton.BackgroundColor3 =
        Color3.fromRGB(0, 135, 220)

    task.wait(0.5)

    -- Joining
    Status.Text = "● ĐANG VÀO SERVER"
    Status.TextColor3 = Color3.fromRGB(80, 180, 255)

    HopButton.Text = "🚀  ĐANG VÀO SERVER..."

    task.wait(0.2)

    local TeleportSuccess = pcall(function()

        TeleportService:TeleportToPlaceInstance(
            PLACE_ID,
            SelectedServer.id,
            LocalPlayer
        )

    end)

    -- Teleport fail
    if not TeleportSuccess then

        Status.Text = "● DỊCH CHUYỂN THẤT BẠI"
        Status.TextColor3 = Color3.fromRGB(255, 80, 90)

        HopButton.Text = "⚠  DỊCH CHUYỂN THẤT BẠI"
        HopButton.BackgroundColor3 = Color3.fromRGB(145, 60, 70)

        task.wait(1)

        HopButton.Text = "⚡  TÌM SERVER 1 NGƯỜI"
        HopButton.BackgroundColor3 = Color3.fromRGB(0, 175, 120)

        Hopping = false

    end

end

